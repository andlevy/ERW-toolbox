function fig = spm_era_sim_transients_figure(sim_num,save_fig)

fig = figure('Units','centimeters','Position',[3 11 32 10]);
set(fig, 'Color', 'w', ...
    'DefaultAxesFontName','Roboto', ...
    'DefaultAxesFontSize',14, ...
    'DefaultTextFontName','Roboto', ...
    'DefaultTextFontSize',14, ...
    'DefaultLineLineWidth',1.5, ...
    'DefaultLineMarkerSize',6);


switch sim_num
    case 'single'

        set(fig,'units','centimeters','position',[10,10,15,15])
        [Y,pst] = transients_sim_single();
        fig_name = 'Method_SimulatedTransient';

    case 'one'

        onssd = [.02 .07 .1];

        for i = 1:length(onssd)

            [Y,pst,pdf] = transients_sim_one(onssd(i));
            sub         = subplot(1,3,i);
            simpatch(Y,pst,pdf,i,sub)

        end

    case 'two'

       skew    = [0 -1 1];

        for i = 1:length(skew)

            [Y,pst,pdf] = transients_sim_two(skew(i));
            sub         = subplot(1,3,i);
            simpatch(Y,pst,pdf,i,sub)
        end

    case 'three'

        pow = [1 2 3];

        for i = 1:length(pow)

            [Y,pst,pdf] = transients_sim_three(pow(i));
            sub    = subplot(1,3,i);
            simpatch(Y,pst,pdf,i,sub)
        end

    case 'four'

        slope    = [1 2 3];

        for i = 1:length(slope)

            [Y,pst,pdf] = transients_sim_four(slope(i));
            sub         = subplot(1,3,i);
            simpatch(Y,pst,pdf,i,sub)

        end

end

if save_fig
    set(fig,'Renderer','painters');
    print(fig,fullfile('figures',fig_name),'-dsvg','-r300');
end

function trans = trans_struct()

trans.pst               = [-.1 1];
trans.dt                = 1/500;
trans.elem(1).type      = 'sin';
trans.elem(1).set.hz    = 20;
trans.elem(1).set.amp   = 10;
trans.elem(1).set.twin  = [0 .0375];
trans.elem(1).set.onset = 0;
trans.elem(2).type      = 'sig';
trans.elem(2).set.k     =  30;
trans.elem(2).set.t0    = .3;
trans.elem(2).set.twin  = [.0375 1];
trans.elem(2).set.amp   = 12;
trans.elem(2).set.onset = 0;
trans.elem(3).type      = 'sin';
trans.elem(3).set.hz    = 20;
trans.elem(3).set.amp   = 8;
trans.elem(3).set.twin  = [0 .0375];
trans.elem(3).set.onset = .3;
trans.elem(4).type      = 'sig';
trans.elem(4).set.k     = 30;
trans.elem(4).set.t0    = .3;
trans.elem(4).set.twin  = [.0375 1];
trans.elem(4).set.amp   = 12;
trans.elem(4).set.onset = .3;

function  [Y,pst] = transients_sim_single()

trans       = trans_struct();
Y           = spm_era_gen_transient(trans);
pst         = trans(1).pst(1):trans(1).dt:trans(1).pst(end);

plot(pst,Y,'k','LineWidth',3)

col = [0.85 0.40 0.15];

curved_arrow(gca,[0.04 0.30],[4.2 4.2], ...
    'Color',brighten(col,.7),'Width',6,'HeadLength',72,'HeadWidth',18);
curved_arrow(gca,[0.04 0.25],[4.2 4.2], ...
    'Color',col,'Width',6,'HeadLength',52,'HeadWidth',18);

curved_arrow(gca,[.375 .375],[-8 5], ...
    'Color',brighten(col,.7),'Width',5,'HeadLength',210,'HeadWidth',18);
curved_arrow(gca,[.375 .375],[-8 3.5], ...
    'Color',col,'Width',5,'HeadLength',180,'HeadWidth',18);

t  = linspace(0,1,1000);
x1 = 0.10 + 0.175*t;
y1 = -9 + 7*(t.^3.5);
x2 = 0.10 + 0.135*t;
y2 = -9 + 7.25*((.99*t).^2.85);
curved_arrow(gca,x2,y2, ...
    'Color',brighten(col,.7),'Width',5,'HeadLength',26,'HeadWidth',16);
curved_arrow(gca,x1,y1, ...
    'Color',col,'Width',5,'HeadLength',26,'HeadWidth',16);


xlim([pst(1) pst(end)])
ylim([-12.5 12.5])
xlabel('PST (s)')
ylabel('\mu V')

ax     = gca;
ax.Box = 'off';


function [Y,pst,ons_pmf] = transients_sim_one(onssd)

npoints = 5000;
ons_int = norminv([.025 .975],.3,onssd);
ons_val = linspace(ons_int(1), ons_int(2), npoints);
ons_pdf = normpdf(ons_val, .3, onssd);

% create approximate pmf
ons_pmf = pdf2pmf(ons_pdf,ons_int,ons_val);

% nbins           = 16;
% edges           = linspace(ons_int(1), ons_int(2), nbins+1);
% dx              = ons_val(2) - ons_val(1);
% [~,~,binIdx]    = histcounts(ons_val, edges);
% counts          = accumarray(binIdx', ons_pdf', [nbins,1]);
% pmf             = counts' * dx;     
% ons_pmf         = pmf(binIdx); 


for i = 1:npoints

    trans(i)                   = trans_struct();
    trans(i).elem(3).set.onset = ons_val(i);
    trans(i).elem(4).set.onset = ons_val(i);

end

Y   = spm_era_gen_transient(trans);
pst = trans(1).pst(1):trans(1).dt:trans(1).pst(end);


function [Y,pst,ons_pmf] = transients_sim_two(skew)

npoints = 5000;
mu    = 0.3;
sigma = 1/2^4;
kurt  = 4.5;

ons_int(1) = fzero(@(x) pearscdf(x, mu, sigma, skew, kurt) - 0.025, [0 0.3]);
ons_int(2) = fzero(@(x) pearscdf(x, mu, sigma, skew, kurt) - 0.975, [0.3 1]);
ons_val    = linspace(ons_int(1), ons_int(2), npoints);
ons_pdf    = pearspdf(ons_val, mu, sigma, skew, kurt);

% create approximate pmf
ons_pmf = pdf2pmf(ons_pdf,ons_int,ons_val);
% nbins           = 16;
% edges           = linspace(ons_int(1), ons_int(2), nbins+1);
% dx              = ons_val(2) - ons_val(1);
% [~,~,binIdx]    = histcounts(ons_val, edges);
% counts          = accumarray(binIdx', ons_pdf', [nbins,1]);
% pmf             = counts' * dx;     
% ons_pmf         = pmf(binIdx); 

for i = 1:npoints
    trans(i)                   = trans_struct();
    trans(i).elem(3).set.onset = ons_val(i);
    trans(i).elem(4).set.onset = ons_val(i);

end
Y  = spm_era_gen_transient(trans);
pst = trans(1).pst(1):trans(1).dt:trans(1).pst(end);

function [Y,pst,ons_pmf] = transients_sim_three(pow)

npoints = 5000;
ons_int = norminv([.025 .975],.3,.1);
ons_val = linspace(ons_int(1), ons_int(2), npoints);
ons_pdf = normpdf(ons_val, .3, .1);

% create approximate pmf
ons_pmf = pdf2pmf(ons_pdf,ons_int,ons_val);

 A0 = 8;
 amp_val = 4000 * (ons_val - .3).^pow ./ 4.^(4-pow) + A0;
for i = 1:npoints

    trans(i)                   = trans_struct();
    trans(i).elem(3).set.amp   = amp_val(i);
    trans(i).elem(3).set.onset = ons_val(i);
    trans(i).elem(4).set.onset = ons_val(i);

end
Y   = spm_era_gen_transient(trans);
pst = trans(1).pst(1):trans(1).dt:trans(1).pst(end);

function [Y,pst,ons_pmf] = transients_sim_four(slope)

npoints = 5000;
ons_int = norminv([.025 .975],.3,.1);
ons_val = linspace(ons_int(1), ons_int(2), npoints);
ons_pdf = normpdf(ons_val, .3, .1);

% K0 = 8; A0 = 8; C0 = [150,1500,3750];
K0 = 30; A0 = 8; C0 = [1 1 1];
% k_val      = ((ons_val-.3)).^slope;
% % k_val      = k_val - min(k_val);
% k_val      = k_val * C0(slope);
% k_val      = k_val + K0;


k_val = 2000 * (ons_val - .3).^slope ./ 4.^(4-slope) + K0;
k_val = fliplr(k_val);
 amp_val = 4000 * (ons_val - .3).^slope ./ 4.^(4-slope) + A0;


% amp_val    = -1*((10*(ons_val-.3)).^slope) +A0;

% k_val   = 70-rescale(((ons_val-.3).^slope),20,60);
% amp_val = -1*((10*(ons_val-.3)).^slope) +8;

% create approximate pmf
ons_pmf = pdf2pmf(ons_pdf,ons_int,ons_val);
% nbins           = 16;
% edges           = linspace(ons_int(1), ons_int(2), nbins+1);
% dx              = ons_val(2) - ons_val(1);
% [~,~,binIdx]    = histcounts(ons_val, edges);
% counts          = accumarray(binIdx', ons_pdf', [nbins,1]);
% pmf             = counts' * dx;     
% ons_pmf         = pmf(binIdx); 

for i = 1:npoints

    trans(i)                   = trans_struct();
    trans(i).elem(2).set.k     = k_val(i);
    trans(i).elem(3).set.amp   = amp_val(i);
    trans(i).elem(3).set.onset = ons_val(i);
    trans(i).elem(4).set.onset = ons_val(i);

end

Y  = spm_era_gen_transient(trans);
pst = trans(1).pst(1):trans(1).dt:trans(1).pst(end);

function simpatch(Y,pst,pdf,coli,sub)

Ymin        = min(Y,[],2);
Ymax        = max(Y,[],2);
Nx          = size(Y,1);
Ny          = 100;
Gx          = pst;%1:Nx;
Gy          = linspace(min(Ymin(:)),max(Ymax(:)),Ny);
% Gxi         = Gx;
% Gyi         = linspace(Gy(1),Gy(2),250);

% Create G mask
%--------------------------------------------------------------------------
Gm   = nan(Nx,Ny);
for x = 1:Nx
    for y = 1:Ny

        if Gy(y) >= Ymin(x) && Gy(y) <= Ymax(x)
            Gm(x,y) = 1;
        end

    end
end

% Populate G with probability
%--------------------------------------------------------------------------
pdf_norm = pdf;
G        = zeros(Nx,Ny);
for p = 1:length(pdf)

    [~,i]   = min(abs(Y(:,p)-Gy),[],2);
    idx     = sub2ind(size(G), [1:Nx]', i(:));
    G(idx)  = max(G(idx),pdf_norm(p));

end
G(G==0&~isnan(Gm)) = nan;
G(isnan(Gm))  = 0;
G = fillmissing2(G,'cubic');
G = G.*Gm;


% Create colourmap
%--------------------------------------------------------------------------
b = -.33;
if coli == 1
    startCol = brighten(hex2rgb('#de63b0'),b);%'#D53398');%'#FF6F61');
elseif coli == 2
    % startCol = hex2rgb('#F5DF4D');
    startCol = brighten(hex2rgb('#b0de63'),b);%'#98d533');%#73e473');
elseif coli == 3
    startCol = brighten(hex2rgb('#63b0de'),b);%'#0F4C81');
end

endCol          = [1 1 1];

ncol            = 12;

% % build a log‐spaced vector from startCol(i) → 1
% r = logspace(log10(startCol(1)), log10(endCol(1)), ncol+1)';
% g = logspace(log10(startCol(2)), log10(endCol(2)), ncol+1)';
% b = logspace(log10(startCol(3)), log10(endCol(3)), ncol+1)';
% 
% cMap = [r g b];
% cMap(1,:) = [];           % drop the darkest entry if desired
% cMap = flipud(cMap);

% alpha = ;            % >1 for slow start / fast finish, <1 for the opposite
t     = linspace(0,1,ncol+1)';   % 0 → 1

% apply gamma
f     = exp(3*t);
f     = rescale(f,0,1);


% interpolate each channel
r = startCol(1) + f*(endCol(1)-startCol(1));
g = startCol(2) + f*(endCol(2)-startCol(2));
b = startCol(3) + f*(endCol(3)-startCol(3));

cMap = [r g b];
cMap(1,:) = [];           % drop the first if you like
cMap = flipud(cMap);


% r               = linspace(startCol(1), endCol(1), ncol+1)';
% g               = linspace(startCol(2), endCol(2), ncol+1)';
% b               = linspace(startCol(3), endCol(3), ncol+1)';
% cMap            = flipud([r g b]);
% cMap(1,:)       = [];
[Gym,Gxm,Gxz]   = meshgrid(Gy,Gx,-1);
% G = (G*100).^2;
nY = size(Y,2);
[~,m] = max(pdf);
hold on
surf(Gxm,Gym,Gxz,G);
view(2)
shading interp
colormap(sub,cMap)
% colorbar(sub,"westoutside")
plot(pst,Y(:,10),'k--','LineWidth',1.5)
plot(pst,Y(:,end-10),'k:','LineWidth',1.5)
plot(pst,Y(:,m),'k','LineWidth',1.5)
xlim([pst(1) pst(end)])
xticks(0:.25:1)
axis square

ylim([-25 15])

% % ----- Parameters you can tweak -------------------------------------------
% scaleMode   = 'quantile';   % 'linear' | 'log' | 'quantile'
% gamma       = 1.5;     % extra gamma after log or quantile (1 = none)
% logFloorFac = 1e-4;    % floor relative to max for log scaling
% ncol        = 10;
% % --------------------------------------------------------------------------
% 
% Ymin  = min(Y,[],2);
% Ymax  = max(Y,[],2);
% Nx    = size(Y,1);
% Ny    = 128;
% Gx    = pst;
% Gy    = linspace(min(Ymin(:)), max(Ymax(:)), Ny);
% 
% % Mask (inside min–max envelope for each time sample)
% Gm = false(Nx,Ny);
% for xi = 1:Nx
%     Gm(xi,:) = Gy >= Ymin(xi) & Gy <= Ymax(xi);
% end
% 
% % Populate density grid (take max across overlapping “trajectories”)
% pdf_norm = pdf;               % assume already normalised or relative
% G         = zeros(Nx,Ny);
% for p = 1:length(pdf_norm)
%     [~,iy]  = min(abs(Y(:,p) - Gy),[],2);
%     idx     = sub2ind([Nx,Ny], (1:Nx)', iy);
%     G(idx)  = max(G(idx), pdf_norm(p));
% end
% % 
% % Interpolate missing (inside mask) linearly along y
% 
% G(G==0&Gm) = nan;
% G(~Gm)  = 0;
% G       = fillmissing2(G,'linear');
% G       = G .* Gm;  % re‑apply mask to keep outside zero
% 
% % ---------------------- SCALING OPTIONS ----------------------------------
% Gvals = G(:);
% nz    = Gvals > 0;
% 
% switch lower(scaleMode)
%     case 'linear'
% 
%         Gscaled = G;              % raw (within mask)
%         % normalise to 0–1
%         if any(nz)
%             Gscaled = Gscaled / max(Gscaled(nz));
%         end
% 
%     case 'log'
% 
%         if ~any(nz)
%             Gscaled = G;
%         else
%             Gmax        = max(Gvals(nz));
%             floorVal    = Gmax * logFloorFac;
%             Gl          = max(G, floorVal);          % avoid log(0)
%             Gscaled     = exp(Gl / floorVal) / exp(Gmax / floorVal);
%         end
% 
%     case 'quantile'
% 
%         if ~any(nz)
%             Gscaled = G;
%         else
%             % Rank transform only over non‑zero density pixels
%             [~,ord]     = sort(Gvals(nz));
%             ranks       = zeros(sum(nz),1);
%             ranks(ord)  = linspace(0,1,sum(nz));  % 0..1
%             Gscaled     = zeros(size(G));
%             Gscaled(nz) = ranks;
%         end
% 
%     otherwise
%         error('Unknown scaleMode "%s".', scaleMode);
% end
% 
% % Optional gamma (perceptual tweak; gamma<1 emphasises tails)
% if gamma ~= 1
%     Gscaled = Gscaled.^gamma;
% end
% Gscaled(~Gm) = nan;
% 
% 
% % ---------------------- COLOURMAP ----------------------------------------
% switch coli
%     case 1, startCol = brighten(hex2rgb('#de63b0'),-.5);
%     case 2, startCol = brighten(hex2rgb('#b0de63'),-.5);
%     case 3, startCol = brighten(hex2rgb('#63b0de'),-.5);
%     otherwise, startCol = [0.3 0.3 0.9];
% end
% endCol          = [1 1 1];
% cMap            = makeRamp(startCol,endCol,ncol);   % darkest -> lightest
% cMap            = flipud(cMap);
% [Gym,Gxm,Gxz]   = meshgrid(Gy,Gx,-1);
% 
% hold on
% surf(Gxm,Gym,Gxz,Gscaled);  % use scaled values for colour
% h = surf(Gxm, Gym, Gxz, Gscaled);
% set(h, 'EdgeColor','none');         % remove the mesh lines entirely
% shading interp;   
% 
% view(2)
% % shading interp
% colormap(sub,cMap)
% 
% % Overlays
% [~,m] = max(pdf);
% plot(pst,Y(:,10),'k--','LineWidth',1.5)
% plot(pst,Y(:,end-10),'k:','LineWidth',1.5)
% plot(pst,Y(:,m),'k','LineWidth',1.5)
% xlim([pst(1) pst(end)])
% xticks(0:.25:1)
% axis square
% % ylim([-25 15])  % if needed
% 
% % colorbar(sub,"westoutside") % optional; now describes scaled metric

% ----------------- Helper: perceptual-ish ramp (simple) ------------------
function cmap = makeRamp(c0,c1,n)
    r = linspace(c0(1),c1(1),n+1)';
    g = linspace(c0(2),c1(2),n+1)';
    b = linspace(c0(3),c1(3),n+1)';
    cmap = [r g b];
    % cmap(1,:) = [];  % drop the darkest endpoint if you wish

function pmf = pdf2pmf(pdf,int,val)

nbins           = 16;
edges           = linspace(int(1), int(2), nbins+1);
dx              = val(2) - val(1);
[~,~,binIdx]    = histcounts(val, edges);
counts          = accumarray(binIdx', pdf', [nbins,1]);
pmf             = counts' * dx;     
pmf             = pmf(binIdx); 

function rgb = hex2rgb(hex)
    if hex(1) == '#'
        hex = hex(2:end);
    end
    rgb = reshape(sscanf(hex, '%2x')', 1, []) / 255;

function h = curved_arrow(ax,x,y,varargin)
%CURVED_ARROW  Draw an arrow following a polyline in data units.
%
%   h = curved_arrow(ax,x,y,Name,Value,...)
%
%   Name/Value pairs:
%       'Color'        : RGB colour (default [0 0 0])
%       'Width'        : Shaft line width (default 3)
%       'HeadLength'   : If HeadSizeData=false -> pixels (default 30)
%                        If HeadSizeData=true  -> data units along tangent
%       'HeadWidth'    : If HeadSizeData=false -> pixels (default 18)
%                        If HeadSizeData=true  -> data units (overall width)
%       'HeadSizeData' : Interpret head sizes in data units (default false)
%       'FaceAlpha'    : Head alpha (default 1)
%       'ShaftTrim'    : Extra fraction of head length to trim (default 0)
%                        (0.1 trims an additional 10% of HeadLength)
%       'LineStyle'    : Shaft line style (default '-')
%
%   Returns struct with handles: h.line, h.head.
%
%   Head shape is constructed in pixel coordinates (aspect invariant)
%   unless HeadSizeData=true.
%
%   Example:
%       t = linspace(0,1,400);
%       x = 0.10 + 0.175*t;
%       y = -9  + 7*(t.^3.5);
%       curved_arrow(gca,x,y,'Color',[0.9 0.45 0.15],'Width',5,'HeadLength',26,'HeadWidth',16);
%

% ---------------- Input parsing ----------------
p = inputParser;
addParameter(p,'Color',[0 0 0]);
addParameter(p,'Width',3);
addParameter(p,'HeadLength',30);
addParameter(p,'HeadWidth',18);
addParameter(p,'HeadSizeData',false);
addParameter(p,'FaceAlpha',1);
addParameter(p,'ShaftTrim',0);
addParameter(p,'LineStyle','-');
parse(p,varargin{:});
pr = p.Results;

if numel(x) ~= numel(y) || numel(x) < 2
    error('x and y must be same length >= 2.');
end

axes(ax); hold(ax,'on');

% Remove any NaNs (breaks) – simple approach: error if present
if any(isnan(x)|isnan(y))
    error('NaNs in polyline not supported.');
end

% ---------------- Axes geometry / transforms ----------------
oldUF = ax.Parent.Units; ax.Parent.Units = 'pixels';
oldUA = ax.Units;        ax.Units        = 'pixels';
axPos = ax.Position;
ax.Parent.Units = oldUF; ax.Units = oldUA;

xlim_ = ax.XLim; ylim_ = ax.YLim;
dx2px = @(xd) axPos(1) + (xd - xlim_(1))/diff(xlim_) * axPos(3);
dy2px = @(yd) axPos(2) + (yd - ylim_(1))/diff(ylim_) * axPos(4);
px2dx = @(xp) ( (xp - axPos(1))/axPos(3) ) * diff(xlim_) + xlim_(1);
py2dy = @(yp) ( (yp - axPos(2))/axPos(4) ) * diff(ylim_) + ylim_(1);

% Polyline in pixels
Xp = dx2px(x(:));
Yp = dy2px(y(:));

% ---------------- Head size in pixels ----------------
if pr.HeadSizeData
    % Approximate: convert a data displacement along x & y into pixels.
    % For along-direction conversion we will simply map a point displaced
    % by HeadLength * tangent later, so do it after direction is known.
    % For width we approximate using y scaling (acceptable for small angles).
    pxPerDataY = axPos(4)/diff(ylim_);
    Wpx_req = pr.HeadWidth * pxPerDataY; % provisional
else
    Lpx = pr.HeadLength;
    Wpx = pr.HeadWidth;
end

% ---------------- Backtrack to find base point ----------------
% Cumulative arc-length in pixel space from start to end
dXp = diff(Xp); dYp = diff(Yp);
segLen = hypot(dXp,dYp);
if any(segLen==0)
    % collapse repeated points
    keep = [true; segLen>0];
    Xp = Xp(keep); Yp = Yp(keep);
    dXp = diff(Xp); dYp = diff(Yp);
    segLen = hypot(dXp,dYp);
end

cumLen = [0; cumsum(segLen)]; % from start
totalLen = cumLen(end);

% We work from the *end* backwards to get a path-length oriented base
% Determine required pixel length for head (plus trim) once we know Lpx
% If HeadSizeData, we cannot compute Lpx until direction known, but
% direction depends (weakly) on base. Use local tangent at end first,
% refine once after computing Lpx from data units (negligible difference).
% Initial head length guess:
if pr.HeadSizeData
    % Convert desired data length to pixels by projecting along local last segment
    if numel(Xp) < 2
        error('Not enough points for direction.');
    end
    v_last = [Xp(end)-Xp(end-1), Yp(end)-Yp(end-1)];
    if norm(v_last)==0
        error('Last segment zero length.');
    end
    v_dir = v_last / norm(v_last);
    % Convert data-unit head length to pixel length:
    % Move a tiny step in data along tangent: approximate derivative
    % Simpler: finite difference between last two *data* points already used.
    dataSeg = [x(end)-x(end-1), y(end)-y(end-1)];
    dataSegLen = norm(dataSeg);
    if dataSegLen==0
        error('Last two data points identical.');
    end
    % pixels per data-unit along direction:
    pxPerDataAlong = norm(v_last)/dataSegLen;
    Lpx = pr.HeadLength * pxPerDataAlong;
    Wpx = Wpx_req; % already derived
end

Lpx_eff = Lpx * (1 + pr.ShaftTrim);

% Walk backwards accumulating length until we exceed Lpx_eff
needed = Lpx_eff;
accum = 0;
i = numel(Xp); % index of tip
while i > 1 && accum < needed
    seg = hypot(Xp(i)-Xp(i-1), Yp(i)-Yp(i-1));
    accum = accum + seg;
    i = i - 1;
end
% Now base lies somewhere between point i and i+1 (towards end)
if accum < needed
    % entire polyline shorter than head length; clamp
    iBase1 = 1; iBase2 = 2;
    tBase  = 0; % at first point
else
    % Remove the last segment overshoot
    overshoot = accum - needed;
    segVec = [Xp(i+1)-Xp(i), Yp(i+1)-Yp(i)];
    segLen_i = norm(segVec);
    tAlong = (segLen_i - overshoot) / segLen_i; % fraction from point i to i+1
    iBase1 = i; iBase2 = i+1;
    tBase  = tAlong;
end
basePixel = [Xp(iBase1) Yp(iBase1)] + tBase * ([Xp(iBase2) Yp(iBase2)] - [Xp(iBase1) Yp(iBase1)]);

% Direction vector from base to tip (pixels)
p_tip = [Xp(end) Yp(end)];
v_dir = p_tip - basePixel;
Lv = norm(v_dir);
if Lv == 0
    % Degenerate: shorten head
    error('Head base coincides with tip; reduce HeadLength or provide more spaced points.');
end
vn = v_dir / Lv;
n  = [-vn(2) vn(1)];

% ---------------- Head polygon (pixels) ----------------
Phead_px = [p_tip;
            basePixel + 0.5*Wpx*n;
            basePixel - 0.5*Wpx*n];

% ---------------- Shaft path reconstruction ----------------
% We need all original points up to basePixel (excluding points after base).
% Collect indices up to iBase1
Xshaft = Xp(1:iBase1);
Yshaft = Yp(1:iBase1);
% Add interpolated base if not coincident with point iBase1
if tBase > 0
    Xshaft(end+1) = basePixel(1);
    Yshaft(end+1) = basePixel(2);
end

% Map pixel shaft back to data units
x_shaft = px2dx(Xshaft);
y_shaft = py2dy(Yshaft);

% Head polygon back to data
Phead_data = [px2dx(Phead_px(:,1)) py2dy(Phead_px(:,2))];

% ---------------- Draw ----------------
h.line = plot(ax,x_shaft,y_shaft,'Color',pr.Color,...
              'LineWidth',pr.Width,'LineStyle',pr.LineStyle);

h.head = patch('XData',Phead_data(:,1),'YData',Phead_data(:,2),...
               'FaceColor',pr.Color,'FaceAlpha',pr.FaceAlpha,...
               'EdgeColor','none','Parent',ax);

if nargout==0
    clear h
end
